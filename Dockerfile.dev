# 本地开发镜像（根目录 docker-compose.dev.yml 专用）：
# 只装 uv 运行时，Python 依赖不进镜像——容器启动时 uv sync 到具名卷 /opt/venv，
# 源码由 compose bind mount 到 /app，改 pyproject/uv.lock 免重建镜像。
# 生产镜像看同目录 Dockerfile。
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONUNBUFFERED=1

WORKDIR /app
