# ============================================================
# folio-auth-server 环境变量示例
# 复制为 .env 后按部署环境填写；.env 不要提交到仓库
# ============================================================

# ---------- 通用 ----------
APP_ENV=development              # development / production（production 未配私钥会拒绝启动）
CORS_ALLOWED_ORIGINS=http://localhost:4001,http://127.0.0.1:4001

# ---------- 上游 IdP（二选一） ----------
AUTH_MODE=oa                    # oa=内部部署（企业 OA SSO） / logto=公网部署（自建 Logto）

# ---- OA 模式（从 AKS .env 平移即可） ----
OA_API_BASE=https://ehrwuji.jiepei.com/oaopenapi
OA_APP_KEY=
OA_APP_SECRET=

# ---- Logto 模式 ----
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_APP_ID=                   # Logto 应用 ID（与前端 NEXT_PUBLIC_LOGTO_APP_ID 一致）
LOGTO_APP_SECRET=               # 机密客户端填；SPA 公共客户端留空（走 PKCE）

# ---------- 本域 token（RS256） ----------
# 私钥二选一注入（生产必配；开发不配则每次启动生成临时密钥，token 重启失效）
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out auth_private_key.pem
# AUTH_RSA_PRIVATE_KEY-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
AUTH_RSA_PRIVATE_KEY_FILE=      # 例：/path/to/auth_private_key.pem（推荐）
AUTH_TOKEN_ISSUER=folio-auth
AUTH_TOKEN_EXPIRES_SECONDS=604800   # 7 天；Phase 4 计划缩短到 43200~86400（12-24h）

# ---------- 用户与角色 ----------
AUTH_DEFAULT_ROLE=user
AUTH_ADMIN_ROLES=admin
AUTH_ADMIN_USER_IDS=            # 引导管理员白名单（首个管理员授角色前使用，逗号分隔）

# ---------- MySQL（folio_auth 库） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dev_folio_auth

# ---------- Redis（可选；OA access_token 缓存，多实例部署必配） ----------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=5
REDIS_PASSWORD=
